# ==============================================================================
# Client / Proxy Environment Variables (.env)
# ==============================================================================

# Google Apps Script Web App Deployment URL
# Deploy apps-script/Code.gs as a Web App (Execute as: Me, Access: Anyone) and paste the /exec URL here.
VITE_APPS_SCRIPT_URL=

# Optional: Shared secret between serverless proxies (Vercel / Netlify) and Google Apps Script.
# Set this exact same secret value in your Apps Script Script Properties as PROXY_SECRET.
PROXY_SECRET=

# Optional: Restrict allowed CORS origins for proxy endpoints (e.g., https://your-domain.vercel.app).
# Leave empty or set to * to allow all origins.
ALLOWED_ORIGIN=

# Optional: Daily global cap on uncached syllabus analyses processed by serverless proxy (default: 10)
DAILY_ANALYSIS_CAP=10

# Optional: Local development port (default: 3000)
VITE_PORT=3000

# ==============================================================================
# Google Apps Script Properties (Set in Apps Script > Project Settings > Script Properties)
# ==============================================================================
# GEMINI_API_KEY          : Primary Google Gemini API key (Required)
# GEMINI_API_KEY_BACKUP   : Failover Gemini API key for quota/rate limit resilience (Optional)
# YOUTUBE_API_KEY         : YouTube Data API v3 key (Optional, falls back to GEMINI_API_KEY)
# GEMINI_MODEL            : Primary structuring model (default: "gemini-2.0-flash-lite")
# GEMINI_FALLBACK_MODEL   : Fallback model if primary JSON validation fails (default: "gemini-2.0-flash")
# MAX_CHARS_PER_CALL      : Max syllabus characters for single Gemini call (default: 25000)
# CACHE_SHEET_ID          : Google Sheet ID for 30-day persistent cache (Optional, auto-created if unset)
# YOUTUBE_DAILY_BUDGET    : Daily YouTube API quota units cap (default: 10000)
# TOPIC_MATCH_THRESHOLD   : Min fuzzy/keyword score to accept playlist video (default: 0.45)
# PROXY_SECRET            : Shared secret matching proxy PROXY_SECRET (Optional)
